<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>SchemeReady.Api.PropertyTests</RootNamespace>
  </PropertyGroup>

  <!--
    Added by hand: the sandbox has no NuGet access, so none of these were restored here.
    Run `dotnet restore` on your machine — see docs/local-build-and-migrations.md.
    FsCheck.Xunit is referenced now because the optional property tests in tasks 5.4, 7.2
    and later phases land in this project; the Phase B baseline test itself is a plain
    xUnit [Theory].
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FsCheck.Xunit" Version="3.0.0" />
  </ItemGroup>

  <!--
    BaselineRecorder owns the seven profiles, the SeedData-backed repository stub and the
    JSON contract. Referencing it rather than copying those files is what guarantees the
    recorded inputs and the asserted inputs cannot drift apart.
  -->
  <ItemGroup>
    <ProjectReference Include="../baseline/BaselineRecorder/BaselineRecorder.csproj" />
  </ItemGroup>

</Project>
